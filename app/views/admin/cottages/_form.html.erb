<%# locals: (cottage:) %>
<%= form_with model: cottage, url: cottage.persisted? ? admin_cottage_path(cottage) : admin_cottages_path, multipart: true, class: "max-w-4xl space-y-8" do |f| %>
  <% if cottage.errors.any? %>
    <div class="bg-red-50 border border-red-200 text-red-800 p-4 rounded">
      <ul class="list-disc list-inside">
        <% cottage.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <section class="bg-white p-6 rounded shadow space-y-4">
    <h2 class="text-lg font-medium">Identité</h2>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="block text-sm uppercase tracking-wider text-gray-700 mb-2">Référence (slug)</label>
        <%= f.text_field :reference, class: "w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-gray-400 font-mono" %>
        <p class="text-xs text-gray-500 mt-1">ex: arums, camellias, hortensias</p>
      </div>
      <div>
        <label class="block text-sm uppercase tracking-wider text-gray-700 mb-2">Position</label>
        <%= f.number_field :position, class: "w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-gray-400" %>
      </div>
    </div>

    <%= render "admin/shared/translatable_field", form: f, attribute: :name, label: "Nom" %>
    <%= render "admin/shared/translatable_field", form: f, attribute: :short_description, label: "Description courte", type: :text_area, rows: 2 %>
    <%= render "admin/shared/translatable_field", form: f, attribute: :full_description, label: "Description complète (markdown)", type: :text_area, rows: 8 %>
  </section>

  <section class="bg-white p-6 rounded shadow space-y-4">
    <h2 class="text-lg font-medium">Caractéristiques</h2>
    <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
      <div>
        <label class="block text-sm uppercase tracking-wider text-gray-700 mb-2">Surface</label>
        <%= f.text_field :surface, placeholder: "65 m²", class: "w-full border border-gray-300 rounded px-3 py-2" %>
      </div>
      <div>
        <label class="block text-sm uppercase tracking-wider text-gray-700 mb-2">Chambres</label>
        <%= f.number_field :room_count, class: "w-full border border-gray-300 rounded px-3 py-2" %>
      </div>
      <div>
        <label class="block text-sm uppercase tracking-wider text-gray-700 mb-2">Couchages</label>
        <%= f.number_field :beddings, class: "w-full border border-gray-300 rounded px-3 py-2" %>
      </div>
      <div>
        <label class="block text-sm uppercase tracking-wider text-gray-700 mb-2">Salles d'eau</label>
        <%= f.number_field :washroom_count, class: "w-full border border-gray-300 rounded px-3 py-2" %>
      </div>
      <div>
        <label class="block text-sm uppercase tracking-wider text-gray-700 mb-2">Parking</label>
        <%= f.number_field :parking_lot_count, class: "w-full border border-gray-300 rounded px-3 py-2" %>
      </div>
      <div class="flex items-end pb-2">
        <label class="flex items-center gap-2 text-sm">
          <%= f.check_box :disabled_access %>
          Accès PMR
        </label>
      </div>
    </div>
  </section>

  <section class="bg-white p-6 rounded shadow space-y-4">
    <h2 class="text-lg font-medium"><%= t("admin.cottages.main_picture") %></h2>
    <% if cottage.main_picture.attached? %>
      <%= image_tag cottage.main_picture, class: "w-64 h-40 object-cover rounded" %>
    <% end %>
    <%= f.file_field :main_picture, accept: "image/*" %>
  </section>

  <section class="bg-white p-6 rounded shadow space-y-4">
    <h2 class="text-lg font-medium"><%= t("admin.cottages.gallery") %></h2>
    <% if cottage.photos.attached? %>
      <div class="grid grid-cols-3 md:grid-cols-5 gap-2">
        <% cottage.photos.each do |photo| %>
          <%= image_tag photo, class: "w-full h-24 object-cover rounded" %>
        <% end %>
      </div>
    <% end %>
    <%= f.file_field :photos, multiple: true, accept: "image/*" %>
    <p class="text-xs text-gray-500">Sélection multiple. Les nouvelles photos sont ajoutées à la galerie existante.</p>
  </section>

  <section class="bg-white p-6 rounded shadow space-y-4">
    <h2 class="text-lg font-medium">Photos pour la card (carrousel home)</h2>
    <% if cottage.card_photos.attached? %>
      <div class="grid grid-cols-3 md:grid-cols-5 gap-2">
        <% cottage.card_photos.each do |photo| %>
          <%= image_tag photo, class: "w-full h-24 object-cover rounded" %>
        <% end %>
      </div>
    <% end %>
    <%= f.file_field :card_photos, multiple: true, accept: "image/*" %>
    <p class="text-xs text-gray-500">Sélection multiple. Si vide, la card affiche la photo principale. Les nouvelles photos sont ajoutées à la sélection existante.</p>
  </section>

  <section class="bg-white p-6 rounded shadow space-y-4">
    <h2 class="text-lg font-medium"><%= t("admin.cottages.details") %></h2>
    <div class="space-y-6" data-controller="nested-form" data-nested-form-target="container">
      <%= f.fields_for :cottage_details do |df| %>
        <div class="border border-gray-200 rounded p-4 space-y-3 relative">
          <%= df.hidden_field :position %>
          <%= df.hidden_field :_destroy, data: { destroy_target: true } %>
          <button type="button"
                  data-action="nested-form#remove"
                  class="absolute top-2 right-2 text-red-500 hover:text-red-700 text-xl leading-none">×</button>
          <%= render "admin/shared/translatable_field", form: df, attribute: :title, label: "Titre du bloc" %>
          <%= render "admin/shared/translatable_field", form: df, attribute: :description, label: "Contenu (markdown)", type: :text_area %>
        </div>
      <% end %>
    </div>
  </section>

  <div class="flex gap-4">
    <%= f.submit t("admin.actions.save"), class: "px-6 py-2 bg-gray-900 text-white uppercase tracking-wider text-sm rounded hover:bg-gray-700 cursor-pointer" %>
    <%= link_to t("admin.actions.cancel"), admin_cottages_path, class: "px-6 py-2 border border-gray-300 uppercase tracking-wider text-sm rounded hover:bg-gray-50" %>
  </div>
<% end %>
