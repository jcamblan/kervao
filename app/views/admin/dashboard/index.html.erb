<h1 class="text-2xl font-light mb-8"><%= t("admin.nav.dashboard") %></h1>

<div class="grid md:grid-cols-2 lg:grid-cols-4 gap-4">
  <%= link_to edit_admin_home_page_path, class: "block bg-white p-6 rounded shadow hover:shadow-md" do %>
    <div class="text-xs uppercase tracking-wider text-gray-500"><%= t("admin.nav.home_page") %></div>
    <div class="text-3xl font-light mt-2">→</div>
  <% end %>

  <%= link_to admin_cottages_path, class: "block bg-white p-6 rounded shadow hover:shadow-md" do %>
    <div class="text-xs uppercase tracking-wider text-gray-500"><%= t("admin.nav.cottages") %></div>
    <div class="text-3xl font-light mt-2"><%= @cottages_count %></div>
  <% end %>

  <%= link_to edit_admin_pricing_path, class: "block bg-white p-6 rounded shadow hover:shadow-md" do %>
    <div class="text-xs uppercase tracking-wider text-gray-500"><%= t("admin.nav.pricing") %></div>
    <div class="text-3xl font-light mt-2">→</div>
  <% end %>

  <%= link_to edit_admin_contact_info_path, class: "block bg-white p-6 rounded shadow hover:shadow-md" do %>
    <div class="text-xs uppercase tracking-wider text-gray-500"><%= t("admin.nav.contact_info") %></div>
    <div class="text-3xl font-light mt-2">→</div>
  <% end %>
</div>
