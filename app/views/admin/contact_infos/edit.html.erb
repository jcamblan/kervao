<h1 class="text-2xl font-light mb-8"><%= t("admin.nav.contact_info") %></h1>

<%= form_with model: @contact_info, url: admin_contact_info_path, method: :patch, class: "max-w-2xl space-y-6" do |f| %>
  <section class="bg-white p-6 rounded shadow space-y-4">
    <%= render "admin/shared/translatable_field", form: f, attribute: :title, label: "Titre de section" %>
    <%= render "admin/shared/translatable_field", form: f, attribute: :address, label: "Adresse", type: :text_area %>

    <div>
      <label class="block text-sm uppercase tracking-wider text-gray-700 mb-2">Téléphone</label>
      <%= f.text_field :phone_number, class: "w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-gray-400" %>
    </div>

    <div>
      <label class="block text-sm uppercase tracking-wider text-gray-700 mb-2">Email</label>
      <%= f.email_field :email, class: "w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-gray-400" %>
    </div>
  </section>

  <%= f.submit t("admin.actions.save"), class: "px-6 py-2 bg-gray-900 text-white uppercase tracking-wider text-sm rounded hover:bg-gray-700 cursor-pointer" %>
<% end %>
