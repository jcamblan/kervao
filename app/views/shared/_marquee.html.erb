<section class="py-8 bg-ink text-bone overflow-hidden">
  <div class="flex overflow-hidden">
    <div class="marquee">
      <% words = ["Crêpes", "Phares", "Dunes", "Aber Wrac'h", "Fruits de mer", "GR34", "Île Molène", "Farz", "Kayak", "Pêche à pied", "Mer d'Iroise"] %>
      <% (words + words).each_with_index do |w, i| %>
        <span class="instrument text-3xl sm:text-4xl <%= i % 3 == 0 ? 'opacity-100' : 'opacity-55' %>"><%= w %></span>
      <% end %>
    </div>
  </div>
</section>
