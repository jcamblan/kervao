<%# locals: (home_page:, cottages:, pricing_periods:) %>
<section id="gites" class="px-8 pt-16 pb-24 max-w-7xl mx-auto">
  <div class="mb-12">
    <span class="badge mb-4"><%= t("home.cottages.badge") %></span>
    <h2 class="display text-4xl sm:text-5xl lg:text-6xl leading-none m-0 -tracking-[0.02em]">
      <%= t("home.cottages.heading_main") %>
      <span class="instrument text-terra"><%= t("home.cottages.heading_emphasis") %></span>
    </h2>
  </div>

  <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
    <% cottages.each_with_index do |cottage, idx| %>
      <% min_price = pricing_periods.flat_map(&:pricing_rates).select { |r| r.cottage_id == cottage.id }.map(&:price).min %>
      <div data-controller="reveal" data-reveal data-reveal-delay="<%= idx + 1 %>">
        <%= render "shared/cottage_card", cottage: cottage, min_price: min_price&.to_i %>
      </div>
    <% end %>
  </div>
</section>
