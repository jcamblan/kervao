<%# locals: (contact_info:) %>
<section id="contact" class="py-20 bg-gray-900 text-gray-100">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl sm:text-4xl font-light uppercase tracking-wide text-center mb-12"><%= contact_info.title %></h2>

    <div class="grid lg:grid-cols-2 gap-12">
      <div class="space-y-8">
        <div class="flex gap-4">
          <span class="text-2xl" aria-hidden>📍</span>
          <div class="prose prose-invert flex-1"><%= markdown(contact_info.address) %></div>
        </div>
        <% if contact_info.phone_number.present? %>
          <div class="flex gap-4">
            <span class="text-2xl" aria-hidden>📞</span>
            <a href="tel:<%= contact_info.phone_number %>" class="text-lg hover:underline"><%= contact_info.phone_number %></a>
          </div>
        <% end %>
        <% if contact_info.email.present? %>
          <div class="flex gap-4">
            <span class="text-2xl" aria-hidden>✉️</span>
            <a href="mailto:<%= contact_info.email %>" class="text-lg hover:underline"><%= contact_info.email %></a>
          </div>
        <% end %>
      </div>

      <div>
        <%= form_with url: contact_path, method: :post, local: true, class: "space-y-4" do |f| %>
          <div>
            <%= f.label :subject, t("contact.form.subject"), class: "block text-sm uppercase tracking-wider mb-1" %>
            <%= f.select :subject,
                [[t("contact.form.booking"), "booking"], [t("contact.form.information"), "information"]],
                {}, class: "w-full bg-gray-800 border border-gray-700 rounded px-3 py-2 text-gray-100 focus:outline-none focus:ring-2 focus:ring-gray-500" %>
          </div>

          <div>
            <%= f.label :name, t("contact.form.name"), class: "block text-sm uppercase tracking-wider mb-1" %>
            <%= f.text_field :name, required: true, class: "w-full bg-gray-800 border border-gray-700 rounded px-3 py-2 text-gray-100 focus:outline-none focus:ring-2 focus:ring-gray-500" %>
          </div>

          <div>
            <%= f.label :email, t("contact.form.email"), class: "block text-sm uppercase tracking-wider mb-1" %>
            <%= f.email_field :email, required: true, class: "w-full bg-gray-800 border border-gray-700 rounded px-3 py-2 text-gray-100 focus:outline-none focus:ring-2 focus:ring-gray-500" %>
          </div>

          <div>
            <%= f.label :message, t("contact.form.message"), class: "block text-sm uppercase tracking-wider mb-1" %>
            <%= f.text_area :message, rows: 5, required: true, class: "w-full bg-gray-800 border border-gray-700 rounded px-3 py-2 text-gray-100 focus:outline-none focus:ring-2 focus:ring-gray-500" %>
          </div>

          <%= f.submit t("contact.form.submit"),
              class: "px-6 py-3 bg-white text-gray-900 uppercase tracking-wider text-sm font-medium hover:bg-gray-200 cursor-pointer" %>
        <% end %>
      </div>
    </div>
  </div>
</section>
